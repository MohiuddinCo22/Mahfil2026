rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only logged-in (committee) users can read or write.
    // No public signup form exists in the app, so only accounts
    // you create manually in Firebase Console can log in.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
